static inline word_t sanitiseRegister(register_t reg, word_t v, bool_t archInfo)
{
    if (reg == CPSR) {

        /* on aarch32 archInfo means 'has VCPU', see Arch_getSanitiseRegisterInfo below */
        if (archInfo) {
            switch (v & 0x1f) {
            case 0x10:
            case 0x11:
            case 0x12:
            case 0x13:
            case 0x17:
            case 0x1b:
            case 0x1f:
                return v;
            case 0x1a:
            default:
                /* For backwards compatibility, Invalid modes revert to USER mode */
                break;
            }
        }


        return (v & 0xf8000000) | ( (1 << 6) | 0x10 | (1 << 8) );
    } else {
        return v;
    }
}

static inline bool_t __attribute__((__pure__)) Arch_getSanitiseRegisterInfo(tcb_t *thread)
{

    return (thread->tcbArch.tcbVCPU != ((void *)0));



}
