        return pde_pde_section_new(
                   nonexecutable, /* Executable */
                   size2, /* contiguous */
                   paddr,
                   1, /* AF - Always set */
                   0, /* not shared */
                   hap,
                   0xf /* Inner and Outer write-back */ /* Cacheable */);
    } else {
        return pde_pde_section_new(
                   nonexecutable, /* Executable */
